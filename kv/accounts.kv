<AccountCard>
    size_hint_y: None
    height: self.minimum_height

    canvas.after:
        Color:
            rgba: get_color_from_hex("#1B5E20")

        Line:
            rounded_rectangle:
                (self.x, self.y,
                self.width, self.height,
                self.radius[0])
            width: 1.2

    BoxLayout:
        id: group_content
        orientation: 'vertical'
        size_hint_y: None
        height: self.minimum_height 

        BoxLayout:
            size_hint_y: None
            height: '56dp'
            padding: '10dp', 0
            spacing: '10dp'

            MDLabel:
                id: account_name
                text_size: self.size
                valign: 'middle'

            MDIconButton:
                icon: "pencil"
                on_release:
                    root.edit_account()

            MDIconButton:
                icon: "delete"
                on_release:
                    root.delete_account()

<AccountsScreen>
    BoxLayout:
        orientation: 'vertical'
        canvas.before:
            Color:
                rgba: get_color_from_hex('#F8F7F4')

            Rectangle:
                pos: self.pos
                size: self.size

        BoxLayout:
            orientation: 'horizontal'
            size_hint_y: None
            height: '64dp'
            padding: '16dp', 0
            spacing: '8dp'
            canvas.before:
                Color:
                    rgba: get_color_from_hex('#B7E892')

                Rectangle:
                    pos: self.pos
                    size: self.size
                    
            MDIconButton:
                icon: 'arrow-left'
                on_release: root.go_to_dashboard()
                theme_icon_color: 'Custom'
                icon_color: get_color_from_hex('#1B5E20')
                pos_hint: {'center_y': .5}

            MDLabel:
                text: 'Accounts'
                font_size: '26sp'
                size_hint_x: 1
                theme_text_color: 'Custom'
                text_color: get_color_from_hex('#1B5E20')

        Widget:
            size_hint_y: None
            height: "1dp"

            canvas.before:
                Color:
                    rgba: get_color_from_hex("#D8D8D8")

                Rectangle:
                    pos: self.pos
                    size: self.size        

        FloatLayout:

            ScrollView:
                size_hint_y: 1
                
                BoxLayout:
                    id: accounts_container
                    size_hint_y: None
                    height: self.minimum_height
                    orientation: 'vertical'
                    padding: '10dp'
                    spacing: '10dp'

            MDCard:
                size_hint: None, None
                size: dp(42), dp(42)
                radius: [36]
                md_bg_color: get_color_from_hex('#B7E892')

                pos_hint: {'right': .96, 'y': .03}

                on_release: root.add_account()

                AnchorLayout:

                    MDIcon:
                        icon: 'plus'
                        pos_hint: {'center_x': .5, 'center_y': .5}