<AccountCard>
    size_hint_y: None
    height: dp(72)

    canvas.after:
        Color:
            rgba: get_color_from_hex(Colors.BRAND_PRIMARY)

        Line:
            rounded_rectangle:
                (self.x, self.y,
                self.width, self.height,
                self.radius[0])
            width: 1.2

    BoxLayout:
        orientation: 'horizontal'
        padding: '12dp', '8dp'
        spacing: '8dp'

        BoxLayout:
            orientation: 'vertical'
            spacing: '2dp'

            MDLabel:
                id: account_name
                text_size: self.size
                valign: 'middle'
                max_lines: 1
                shorten: True
                shorten_from: 'right'

            MDLabel:
                id: interest_summary
                text: root.interest_summary_text
                text_size: self.size
                valign: 'middle'
                font_size: '11sp'
                theme_text_color: 'Custom'
                text_color: get_color_from_hex(Colors.TEXT_SECONDARY)
                max_lines: 1
                shorten: True
                shorten_from: 'right'

        MDRectangleFlatButton:
            text: "INTEREST"
            size_hint_x: None
            size_hint_y: None
            width: dp(96)
            height: dp(48)
            radius: [dp(14), dp(14), dp(14), dp(14)]
            line_width: 1.2
            line_color: get_color_from_hex(Colors.BRAND_PRIMARY)
            md_bg_color: get_color_from_hex(Colors.SURFACE)
            text_color: get_color_from_hex(Colors.BRAND_PRIMARY)
            pos_hint: {'center_y': .5}
            on_release: root.manage_interest()

        MDIconButton:
            icon: "pencil"
            pos_hint: {'center_y': .5}
            on_release:
                root.edit_account()

        MDIconButton:
            icon: "delete"
            pos_hint: {'center_y': .5}
            on_release:
                root.delete_account()

<AccountsScreen>
    BoxLayout:
        orientation: 'vertical'
        canvas.before:
            Color:
                rgba: get_color_from_hex(Colors.BACKGROUND)

            Rectangle:
                pos: self.pos
                size: self.size

        BoxLayout:
            orientation: 'horizontal'
            size_hint_y: None
            height: '64dp'
            padding: '16dp', 0
            spacing: '8dp'
            canvas.before:
                Color:
                    rgba: get_color_from_hex(Colors.BRAND_PRIMARY)

                Rectangle:
                    pos: self.pos
                    size: self.size
                    
            MDIconButton:
                icon: 'arrow-left'
                on_release: root.go_back()
                theme_icon_color: 'Custom'
                icon_color: get_color_from_hex(Colors.TEXT_ON_PRIMARY)
                pos_hint: {'center_y': .5}

            MDLabel:
                text: 'Accounts'
                font_size: '26sp'
                size_hint_x: 1
                theme_text_color: 'Custom'
                text_color: get_color_from_hex(Colors.TEXT_ON_PRIMARY)

        Widget:
            size_hint_y: None
            height: "1dp"

            canvas.before:
                Color:
                    rgba: get_color_from_hex(Colors.BORDER)

                Rectangle:
                    pos: self.pos
                    size: self.size        

        FloatLayout:

            ScrollView:
                size_hint_y: 1
                
                BoxLayout:
                    id: accounts_container
                    size_hint_y: None
                    height: self.minimum_height
                    orientation: 'vertical'
                    padding: '10dp'
                    spacing: '10dp'

            MDCard:
                size_hint: None, None
                size: dp(48), dp(48)
                radius: [36]
                md_bg_color: get_color_from_hex(Colors.SURFACE_MUTED)

                pos_hint: {'right': .96, 'y': .03}

                on_release: root.add_account()

                AnchorLayout:

                    MDIcon:
                        icon: 'plus'
                        pos_hint: {'center_x': .5, 'center_y': .5}
