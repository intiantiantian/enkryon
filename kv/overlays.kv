#:import Window kivy.core.window.Window
#:import dp kivy.metrics.dp
#:import get_color_from_hex kivy.utils.get_color_from_hex
#:import Colors theme.tokens.Colors
#:import Elevation theme.tokens.Elevation
#:import Radius theme.tokens.Radius

<EnkryonOverlay>:
    size_hint: None, None
    width: root.calculate_width(Window.width)
    auto_dismiss: False
    background: ""
    background_color: 0, 0, 0, 0
    overlay_color: 0, 0, 0, .48

<EnkryonOverlayCard>:
    radius: [dp(Radius.LG)]
    md_bg_color: get_color_from_hex(Colors.SURFACE)
    elevation: Elevation.HIGH


<EnkryonSelectionOption>:
    size_hint_y: None
    height: dp(52) + (dp(12) if root.is_navigation else 0)
    orientation: "vertical"
    padding: 0
    spacing: 0
    radius: [0, 0, 0, 0]
    elevation: Elevation.NONE
    ripple_behavior: False
    md_bg_color: 0, 0, 0, 0

    Widget:
        size_hint_y: None
        height: dp(12) if root.is_navigation else 0

        canvas:
            Color:
                rgba: get_color_from_hex(Colors.BORDER) if root.is_navigation else (0, 0, 0, 0)

            Rectangle:
                pos: self.x, self.center_y
                size: self.width, dp(1)

    EnkryonOverlayCard:
        size_hint_y: None
        height: dp(52)
        orientation: "horizontal"
        padding: [dp(16), 0, dp(12), 0]
        radius: [dp(Radius.MD)]
        elevation: Elevation.NONE
        ripple_behavior: True
        md_bg_color: get_color_from_hex(Colors.BRAND_ACCENT_SOFT) if root.is_selected else get_color_from_hex(Colors.SURFACE_MUTED)
        on_release: root.activate()

        MDLabel:
            text: root.text
            theme_text_color: "Custom"
            text_color: get_color_from_hex(Colors.TEXT_PRIMARY)
            shorten: True
            shorten_from: "right"
            max_lines: 1

        AnchorLayout:
            size_hint_x: None
            width: dp(24)
            anchor_x: "center"
            anchor_y: "center"

            MDIcon:
                icon: "check"
                size_hint: None, None
                size: dp(24), dp(24)
                theme_text_color: "Custom"
                text_color: get_color_from_hex(Colors.BRAND_PRIMARY)
                opacity: 1 if root.is_selected else 0


<EnkryonSelectionPanel>:
    height: root.calculate_height(Window.height, len(root.options))

    EnkryonOverlayCard:
        size_hint: 1, 1
        orientation: "vertical"
        padding: dp(16)
        spacing: dp(8)

        BoxLayout:
            size_hint_y: None
            height: dp(48)

            MDLabel:
                text: root.title
                font_size: "18sp"
                bold: True
                theme_text_color: "Custom"
                text_color: get_color_from_hex(Colors.TEXT_PRIMARY)
                shorten: True
                shorten_from: "right"
                max_lines: 1

            MDIconButton:
                icon: "close"
                theme_icon_color: "Custom"
                icon_color: get_color_from_hex(Colors.BRAND_PRIMARY)
                on_release: root.dismiss()

        ScrollView:
            do_scroll_x: False
            bar_width: dp(4)

            MDBoxLayout:
                id: options_container
                orientation: "vertical"
                adaptive_height: True
                spacing: dp(4)
