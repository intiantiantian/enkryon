#:import Window kivy.core.window.Window
#:import Metrics kivy.metrics.Metrics
#:import should_stack_controls utils.responsive_layout.should_stack_controls


<AddTransactionScreen>:
    BoxLayout:
        orientation: 'vertical'
        canvas.before:
            Color:
                rgba: get_color_from_hex(Colors.BACKGROUND)

            Rectangle:
                pos: self.pos
                size: self.size

        BoxLayout:
            orientation: 'horizontal'
            size_hint_y: None
            height: '64dp'
            padding: '16dp', 0
            spacing: '8dp'
            canvas.before:
                Color:
                    rgba: get_color_from_hex(Colors.BRAND_PRIMARY)

                Rectangle:
                    pos: self.pos
                    size: self.size
                    
            MDIconButton:
                icon: 'arrow-left'
                on_release: root.go_to_dashboard()
                theme_icon_color: 'Custom'
                icon_color: get_color_from_hex(Colors.TEXT_ON_PRIMARY)
                pos_hint: {'center_y': .5}

            MDLabel:
                text: 'Add Transaction'
                font_size: '26sp'
                size_hint_x: 1
                theme_text_color: 'Custom'
                text_color: get_color_from_hex(Colors.TEXT_ON_PRIMARY)

            MDIconButton:
                icon: 'content-save'
                on_release: root.save_transaction()
                theme_icon_color: 'Custom'
                icon_color: get_color_from_hex(Colors.TEXT_ON_PRIMARY)
                pos_hint: {'center_y': .5}

        Widget:
            size_hint_y: None
            height: "1dp"

            canvas.before:
                Color:
                    rgba: get_color_from_hex(Colors.BORDER)

                Rectangle:
                    pos: self.pos
                    size: self.size        

        ScrollView:

            BoxLayout:
                orientation: 'vertical'
                size_hint_y: None
                height: self.minimum_height
                padding: '16dp'
                spacing: '12dp'

                BoxLayout:
                    size_hint_y: None
                    height: '56dp'
                    padding: '8dp'
                    orientation: 'horizontal'
                    spacing: '8dp'

                    EnkryonFilterButton:
                        id: income_button
                        text: "INCOME"
                        size_hint_x: 1
                        on_release: root.update_groups_button('income')

                    EnkryonFilterButton:
                        id: expense_button
                        text: "EXPENSE"
                        size_hint_x: 1
                        on_release: root.update_groups_button('expense')
                        
                OutlinedCard:
                    size_hint_y: None
                    height: "180dp"
                    orientation: "horizontal"
                    padding: "16dp"
                    spacing: "12dp"

                    AnchorLayout:
                        anchor_x: "center"
                        anchor_y: "top"
                        size_hint_x: 1

                        MDCard:
                            id: account_selector
                            size_hint: 1, None
                            height: '48dp'
                            radius: [14]
                            elevation: 1
                            ripple_behavior: True
                            md_bg_color: get_color_from_hex(Colors.BRAND_PRIMARY)
                            on_release: root.open_account_menu()

                            MDLabel:
                                id: account_label
                                size_hint_x: 1
                                text: 'Select Account'
                                halign: 'center'
                                valign: 'middle'
                                text_size: self.width - dp(24), self.height
                                max_lines: 1
                                shorten: True
                                shorten_from: 'right'
                                theme_text_color: 'Custom'
                                text_color: get_color_from_hex(Colors.TEXT_ON_PRIMARY)

                    MDLabel:
                        id: amount_label
                        halign: "right"
                        valign: "middle"
                        text_size: self.size
                        font_size: "32sp"
                        text: "₱ 0"

                GridLayout:
                    id: keypad_container
                    cols: 4
                    spacing: "8dp"
                    size_hint_y: None
                    height: self.minimum_height

                OutlinedCard:
                    orientation: 'vertical'
                    size_hint_y: None
                    height: self.minimum_height
                    padding: '16dp'
                    spacing: '12dp'

                    GridLayout:
                        cols: 1 if should_stack_controls(Window.width / dp(1), Metrics.fontscale) else 2
                        size_hint_y: None
                        height: self.minimum_height
                        row_default_height: '64dp'
                        row_force_default: True
                        spacing: '12dp'

                        OutlinedCard:
                            id: group_selector
                            size_hint: 1, None
                            height: "64dp"
                            ripple_behavior: True
                            md_bg_color: get_color_from_hex(Colors.BRAND_ACCENT_SOFT)
                            on_release: root.open_groups_menu()

                            MDLabel:
                                id: group_label
                                halign: "center"
                                theme_text_color: "Custom"
                                text_color: get_color_from_hex(Colors.BRAND_PRIMARY)
                                valign: "middle"
                                text_size: self.width - dp(16), self.height
                                max_lines: 1
                                shorten: True
                                shorten_from: "right"

                        OutlinedCard:
                            id: category_selector
                            size_hint: 1, None
                            height: "64dp"
                            ripple_behavior: True
                            md_bg_color: get_color_from_hex(Colors.BRAND_ACCENT_SOFT)
                            on_release: root.open_categories_menu()

                            MDLabel:
                                id: category_label
                                halign: "center"
                                theme_text_color: "Custom"
                                text_color: get_color_from_hex(Colors.BRAND_PRIMARY)
                                valign: "middle"
                                text_size: self.width - dp(16), self.height
                                max_lines: 1
                                shorten: True
                                shorten_from: "right"

                    GridLayout:
                        cols: 1 if should_stack_controls(Window.width / dp(1), Metrics.fontscale) else 2
                        size_hint_y: None
                        height: self.minimum_height
                        row_default_height: '64dp'
                        row_force_default: True
                        spacing: '12dp'

                        OutlinedCard:
                            id: date_selector
                            size_hint: 1, None
                            height: "64dp"
                            ripple_behavior: True
                            md_bg_color: get_color_from_hex(Colors.BRAND_ACCENT_SOFT)
                            on_release: root.open_date_picker()

                            MDLabel:
                                id: date_label
                                halign: "center"
                                theme_text_color: "Custom"
                                text_color: get_color_from_hex(Colors.BRAND_PRIMARY)
                                valign: "middle"
                                text_size: self.width - dp(16), self.height
                                max_lines: 1
                                shorten: True
                                shorten_from: "right"

                        OutlinedCard:
                            id: time_selector
                            size_hint: 1, None
                            height: "64dp"
                            ripple_behavior: True
                            md_bg_color: get_color_from_hex(Colors.BRAND_ACCENT_SOFT)
                            on_release: root.open_time_picker()

                            MDLabel:
                                id: time_label
                                halign: "center"
                                theme_text_color: "Custom"
                                text_color: get_color_from_hex(Colors.BRAND_PRIMARY)
                                valign: "middle"
                                text_size: self.width - dp(16), self.height
                                max_lines: 1
                                shorten: True
                                shorten_from: "right"

                OutlinedCard:
                    orientation: 'vertical'
                    size_hint_y: None
                    height: self.minimum_height
                    padding: dp(16)
                    spacing: '8dp'

                    MDLabel:
                        text: 'Notes'
                        size_hint_y: None
                        height: dp(20)

                    MDCard:
                        size_hint_y: None
                        height: dp(56)
                        ripple_behavior: True
                        on_release: root.add_notes()
                        padding: dp(16)

                        MDLabel:
                            id: notes_label
                            text: 'Add notes'
                            halign: 'left'
                            valign: 'middle'
                            text_size: self.size
                            theme_text_color: 'Custom'
                            text_color: get_color_from_hex(Colors.TEXT_SECONDARY)
                            shorten: True
                            shorten_from: 'right'
