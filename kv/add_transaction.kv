<AddTransactionScreen>:
    BoxLayout:
        orientation: 'vertical'
        canvas.before:
            Color:
                rgba: get_color_from_hex('#F8F7F4')

            Rectangle:
                pos: self.pos
                size: self.size

        BoxLayout:
            orientation: 'horizontal'
            size_hint_y: None
            height: '64dp'
            padding: '16dp', 0
            spacing: '8dp'
            canvas.before:
                Color:
                    rgba: get_color_from_hex('#B7E892')

                Rectangle:
                    pos: self.pos
                    size: self.size
                    
            MDIconButton:
                icon: 'arrow-left'
                on_release: root.go_to_dashboard()
                theme_icon_color: 'Custom'
                icon_color: get_color_from_hex('#1B5E20')
                pos_hint: {'center_y': .5}

            MDLabel:
                text: 'Add Transaction'
                font_size: '26sp'
                size_hint_x: 1
                theme_text_color: 'Custom'
                text_color: get_color_from_hex('#1B5E20')

            MDIconButton:
                icon: 'content-save'
                on_release: root.save_transaction()
                theme_icon_color: 'Custom'
                icon_color: get_color_from_hex('#1B5E20')
                pos_hint: {'center_y': .5}

        Widget:
            size_hint_y: None
            height: "1dp"

            canvas.before:
                Color:
                    rgba: get_color_from_hex("#D8D8D8")

                Rectangle:
                    pos: self.pos
                    size: self.size        

        ScrollView:

            BoxLayout:
                orientation: 'vertical'
                size_hint_y: None
                height: self.minimum_height
                padding: 20
                spacing: 15

                BoxLayout:
                    size_hint_y: None
                    height: '56dp'
                    padding: '10dp'

                    orientation: 'horizontal'
                    spacing: '10dp'

                    OutlinedCard:
                        id: income_button
                        on_release:
                            root.update_groups_button('income')
                        ripple_behavior: True
                        md_bg_color: get_color_from_hex('#D5F4BE')
                        radius: [10]

                        MDLabel:
                            halign: 'center'
                            text: 'INCOME'
                            theme_text_color: 'Custom'
                            text_color: get_color_from_hex('#1B5E20')

                    OutlinedCard:
                        id: expense_button
                        on_release:
                            root.update_groups_button('expense')
                        ripple_behavior: True
                        md_bg_color: get_color_from_hex('#D5F4BE')
                        radius: [10]

                        MDLabel:
                            halign: 'center'
                            text: 'EXPENSE'
                            theme_text_color: 'Custom'
                            text_color: get_color_from_hex('#1B5E20')
                        
                OutlinedCard:
                    size_hint_y: None
                    height: "180dp"
                    orientation: "horizontal"
                    padding: "10dp"

                    AnchorLayout:
                        anchor_x: "center"
                        anchor_y: "top"
                        size_hint_x: 0.4

                        OutlinedCard:
                            id: account_selector
                            size_hint: 1, None
                            height: "64dp"
                            ripple_behavior: True
                            md_bg_color: get_color_from_hex('#D5F4BE')
                            on_release: root.open_account_menu()

                            MDLabel:
                                id: account_label
                                halign: "center"
                                theme_text_color: "Custom"
                                text_color: get_color_from_hex('#1B5E20')

                    MDLabel:
                        id: amount_label
                        halign: "right"
                        valign: "middle"
                        text_size: self.size
                        font_size: "32sp"
                        text: "₱ 0"

                GridLayout:
                    id: keypad_container
                    cols: 4
                    spacing: "8dp"
                    size_hint_y: None
                    height: self.minimum_height

                OutlinedCard:
                    orientation: 'vertical'
                    size_hint_y: None
                    height: self.minimum_height
                    padding: '20dp'
                    spacing: '20dp'

                    BoxLayout:
                        orientation: 'horizontal'
                        size_hint_y: None
                        height: '64dp'
                        spacing: '20dp'

                        OutlinedCard:
                            id: group_selector
                            size_hint: 1, None
                            height: "64dp"
                            ripple_behavior: True
                            md_bg_color: get_color_from_hex('#D5F4BE')
                            on_release: root.open_groups_menu()

                            MDLabel:
                                id: group_label
                                halign: "center"
                                theme_text_color: "Custom"
                                text_color: get_color_from_hex('#1B5E20')

                        OutlinedCard:
                            id: category_selector
                            size_hint: 1, None
                            height: "64dp"
                            ripple_behavior: True
                            md_bg_color: get_color_from_hex('#D5F4BE')
                            on_release: root.open_categories_menu()

                            MDLabel:
                                id: category_label
                                halign: "center"
                                theme_text_color: "Custom"
                                text_color: get_color_from_hex('#1B5E20')

                    BoxLayout:
                        orientation: 'horizontal'
                        size_hint_y: None
                        height: '64dp'
                        spacing: '20dp'

                        OutlinedCard:
                            id: date_selector
                            size_hint: 1, None
                            height: "64dp"
                            ripple_behavior: True
                            md_bg_color: get_color_from_hex('#D5F4BE')
                            on_release: root.open_date_picker()

                            MDLabel:
                                id: date_label
                                halign: "center"
                                theme_text_color: "Custom"
                                text_color: get_color_from_hex('#1B5E20')

                        OutlinedCard:
                            id: time_selector
                            size_hint: 1, None
                            height: "64dp"
                            ripple_behavior: True
                            md_bg_color: get_color_from_hex('#D5F4BE')
                            on_release: root.open_time_picker()

                            MDLabel:
                                id: time_label
                                halign: "center"
                                theme_text_color: "Custom"
                                text_color: get_color_from_hex('#1B5E20')

                OutlinedCard:
                    orientation: 'vertical'
                    size_hint_y: None
                    height: self.minimum_height
                    padding: dp(16)

                    MDLabel:
                        text: 'Notes'
                        size_hint_y: None
                        height: dp(20)

                    MDCard:
                        size_hint_y: None
                        height: dp(56)
                        ripple_behavior: True
                        on_release: root.add_notes()
                        padding: dp(16)

                        MDLabel:
                            id: notes_label
                            text: 'Add notes'
                            halign: 'left'
                            valign: 'middle'
                            text_size: self.size
                            theme_text_color: 'Hint'
                            shorten: True
                            shorten_from: 'right'