<SettingsScreen>
    BoxLayout:
        orientation: 'vertical'
        canvas.before:
            Color:
                rgba: get_color_from_hex(Colors.BACKGROUND)

            Rectangle:
                pos: self.pos
                size: self.size

        BoxLayout:
            orientation: 'horizontal'
            size_hint_y: None
            height: '64dp'
            padding: '16dp', 0
            spacing: '8dp'
            canvas.before:
                Color:
                    rgba: get_color_from_hex(Colors.BRAND_PRIMARY)

                Rectangle:
                    pos: self.pos
                    size: self.size
                    
            MDIconButton:
                icon: 'arrow-left'
                on_release: root.go_to_dashboard()
                theme_icon_color: 'Custom'
                icon_color: get_color_from_hex(Colors.TEXT_ON_PRIMARY)
                pos_hint: {'center_y': .5}

            MDLabel:
                text: 'Settings'
                font_size: '26sp'
                size_hint_x: 1
                theme_text_color: 'Custom'
                text_color: get_color_from_hex(Colors.TEXT_ON_PRIMARY)

        Widget:
            size_hint_y: None
            height: "1dp"

            canvas.before:
                Color:
                    rgba: get_color_from_hex(Colors.BORDER)

                Rectangle:
                    pos: self.pos
                    size: self.size        

        ScrollView:
            size_hint_y: 1
            do_scroll_x: False

            BoxLayout:
                orientation: "vertical"
                size_hint_y: None
                height: self.minimum_height
                padding: "16dp"
                spacing: "12dp"

                MDLabel:
                    text: "About"
                    size_hint_y: None
                    height: self.texture_size[1]
                    text_size: self.width, None
                    font_size: "18sp"
                    bold: True
                    theme_text_color: "Custom"
                    text_color: get_color_from_hex(Colors.TEXT_PRIMARY)

                OutlinedCard:
                    orientation: "vertical"
                    size_hint_y: None
                    height: self.minimum_height
                    padding: "16dp"
                    spacing: "8dp"
                    md_bg_color: get_color_from_hex(Colors.SURFACE)

                    MDLabel:
                        text: "Enkryon"
                        size_hint_y: None
                        height: self.texture_size[1]
                        text_size: self.width, None
                        font_size: "16sp"
                        bold: True
                        theme_text_color: "Custom"
                        text_color: get_color_from_hex(Colors.BRAND_PRIMARY)

                    MDLabel:
                        text: "Version {}".format(app.version)
                        size_hint_y: None
                        height: self.texture_size[1]
                        text_size: self.width, None
                        font_size: "13sp"
                        theme_text_color: "Custom"
                        text_color: get_color_from_hex(Colors.TEXT_SECONDARY)

                    MDLabel:
                        text: "Simple, local-first personal finance tracking."
                        size_hint_y: None
                        height: self.texture_size[1]
                        text_size: self.width, None
                        font_size: "14sp"
                        theme_text_color: "Custom"
                        text_color: get_color_from_hex(Colors.TEXT_PRIMARY)

                MDLabel:
                    text: "Data & Privacy"
                    size_hint_y: None
                    height: self.texture_size[1]
                    text_size: self.width, None
                    font_size: "18sp"
                    bold: True
                    theme_text_color: "Custom"
                    text_color: get_color_from_hex(Colors.TEXT_PRIMARY)

                OutlinedCard:
                    orientation: "vertical"
                    size_hint_y: None
                    height: self.minimum_height
                    padding: "16dp"
                    spacing: "8dp"
                    md_bg_color: get_color_from_hex(Colors.SURFACE)

                    MDLabel:
                        text: "Local data and privacy"
                        size_hint_y: None
                        height: self.texture_size[1]
                        text_size: self.width, None
                        font_size: "16sp"
                        bold: True
                        theme_text_color: "Custom"
                        text_color: get_color_from_hex(Colors.BRAND_PRIMARY)

                    MDLabel:
                        text: "Your accounts, categories, and transactions are stored locally on this device. Enkryon does not require an account or upload your financial data."
                        size_hint_y: None
                        height: self.texture_size[1]
                        text_size: self.width, None
                        font_size: "14sp"
                        theme_text_color: "Custom"
                        text_color: get_color_from_hex(Colors.TEXT_PRIMARY)

                    MDLabel:
                        text: "Android automatic backup remains disabled. Uninstalling Enkryon, clearing its app data, or choosing Clear All Data can permanently remove records that you have not exported."
                        size_hint_y: None
                        height: self.texture_size[1]
                        text_size: self.width, None
                        font_size: "13sp"
                        theme_text_color: "Custom"
                        text_color: get_color_from_hex(Colors.TEXT_SECONDARY)

                MDLabel:
                    text: "Backup & Restore"
                    size_hint_y: None
                    height: self.texture_size[1]
                    text_size: self.width, None
                    font_size: "18sp"
                    bold: True
                    theme_text_color: "Custom"
                    text_color: get_color_from_hex(Colors.TEXT_PRIMARY)

                OutlinedCard:
                    orientation: "vertical"
                    size_hint_y: None
                    height: self.minimum_height
                    padding: "16dp"
                    spacing: "8dp"
                    md_bg_color: get_color_from_hex(Colors.SURFACE)

                    MDLabel:
                        text: "Your backup files"
                        size_hint_y: None
                        height: self.texture_size[1]
                        text_size: self.width, None
                        font_size: "16sp"
                        bold: True
                        theme_text_color: "Custom"
                        text_color: get_color_from_hex(Colors.BRAND_PRIMARY)

                    MDLabel:
                        text: "Export creates a JSON backup in the location you choose. Enkryon does not upload or sync it. You can move that file to another device and select it with Restore Backup."
                        size_hint_y: None
                        height: self.texture_size[1]
                        text_size: self.width, None
                        font_size: "14sp"
                        theme_text_color: "Custom"
                        text_color: get_color_from_hex(Colors.TEXT_PRIMARY)

                    MDLabel:
                        text: "A selected backup is fully validated and summarized before it can replace the data currently stored on this device."
                        size_hint_y: None
                        height: self.texture_size[1]
                        text_size: self.width, None
                        font_size: "13sp"
                        theme_text_color: "Custom"
                        text_color: get_color_from_hex(Colors.TEXT_SECONDARY)

                OutlinedCard:
                    orientation: "vertical"
                    size_hint_y: None
                    height: self.minimum_height
                    padding: "16dp"
                    spacing: "4dp"
                    ripple_behavior: True
                    md_bg_color: get_color_from_hex(Colors.SURFACE)
                    on_release: root.export_backup()

                    MDLabel:
                        text: "Export Backup"
                        size_hint_y: None
                        height: self.texture_size[1]
                        text_size: self.width, None
                        theme_text_color: "Custom"
                        text_color: get_color_from_hex(Colors.BRAND_PRIMARY)
                        bold: True

                    MDLabel:
                        text: "Save a complete copy of your accounts, categories, and transactions."
                        size_hint_y: None
                        height: self.texture_size[1]
                        text_size: self.width, None
                        font_size: "13sp"
                        theme_text_color: "Custom"
                        text_color: get_color_from_hex(Colors.TEXT_SECONDARY)

                OutlinedCard:
                    orientation: "vertical"
                    size_hint_y: None
                    height: self.minimum_height
                    padding: "16dp"
                    spacing: "4dp"
                    ripple_behavior: True
                    md_bg_color: get_color_from_hex(Colors.SURFACE)
                    on_release: root.restore_backup()

                    MDLabel:
                        text: "Restore Backup"
                        size_hint_y: None
                        height: self.texture_size[1]
                        text_size: self.width, None
                        theme_text_color: "Custom"
                        text_color: get_color_from_hex(Colors.BRAND_PRIMARY)
                        bold: True

                    MDLabel:
                        text: "Choose a backup, review its contents, and replace the data on this device."
                        size_hint_y: None
                        height: self.texture_size[1]
                        text_size: self.width, None
                        font_size: "13sp"
                        theme_text_color: "Custom"
                        text_color: get_color_from_hex(Colors.TEXT_SECONDARY)

                OutlinedCard:
                    orientation: "vertical"
                    size_hint_y: None
                    height: self.minimum_height
                    padding: "16dp"
                    spacing: "4dp"
                    ripple_behavior: True
                    md_bg_color: get_color_from_hex(Colors.SURFACE)
                    on_release: root.clear_data()

                    MDLabel:
                        text: "Clear All Data"
                        size_hint_y: None
                        height: self.texture_size[1]
                        text_size: self.width, None
                        theme_text_color: "Custom"
                        text_color: get_color_from_hex(Colors.ERROR)
                        bold: True

                    MDLabel:
                        text: "Permanently delete every account, category, and transaction. Enkryon offers to export a backup before deletion."
                        size_hint_y: None
                        height: self.texture_size[1]
                        text_size: self.width, None
                        font_size: "13sp"
                        theme_text_color: "Custom"
                        text_color: get_color_from_hex(Colors.TEXT_SECONDARY)
