#:import Window kivy.core.window.Window
#:import dp kivy.metrics.dp
#:import get_color_from_hex kivy.utils.get_color_from_hex
#:import Colors theme.tokens.Colors

<InterestSettingsDialog>:
    height: root.calculate_height(Window.height)

    EnkryonOverlayCard:
        size_hint: 1, 1
        orientation: "vertical"
        padding: dp(20)
        spacing: dp(12)

        BoxLayout:
            size_hint_y: None
            height: dp(48)

            MDLabel:
                text: "Daily Bank Interest"
                font_size: "20sp"
                bold: True
                theme_text_color: "Custom"
                text_color: get_color_from_hex(Colors.TEXT_PRIMARY)
                shorten: True
                shorten_from: "right"
                max_lines: 1

            MDIconButton:
                icon: "close"
                theme_icon_color: "Custom"
                icon_color: get_color_from_hex(Colors.BRAND_PRIMARY)
                on_release: root.dismiss()

        ScrollView:
            do_scroll_x: False
            bar_width: dp(4)

            BoxLayout:
                orientation: "vertical"
                size_hint_y: None
                height: self.minimum_height
                spacing: dp(12)

                MDLabel:
                    text: root.account_name
                    size_hint_y: None
                    height: max(dp(24), self.texture_size[1])
                    text_size: self.width, None
                    bold: True
                    theme_text_color: "Custom"
                    text_color: get_color_from_hex(Colors.BRAND_PRIMARY)
                    shorten: True
                    shorten_from: "right"
                    max_lines: 1

                MDLabel:
                    text: "ESTIMATE ONLY · NON-POSTING"
                    size_hint_y: None
                    height: dp(20)
                    font_size: "12sp"
                    bold: True
                    theme_text_color: "Custom"
                    text_color: get_color_from_hex(Colors.WARNING)

                MDLabel:
                    text: "Enkryon estimates daily interest from the prior end-of-day posted balance. Estimates do not change account balances or Income until you explicitly reconcile a bank credit."
                    size_hint_y: None
                    height: self.texture_size[1]
                    text_size: self.width, None
                    font_size: "13sp"
                    theme_text_color: "Custom"
                    text_color: get_color_from_hex(Colors.TEXT_SECONDARY)

                MDTextField:
                    id: apr_input
                    text: root.apr_text
                    hint_text: "APR (%)"
                    helper_text: "Nominal APR; up to 6 decimal places"
                    helper_text_mode: "persistent"
                    mode: "rectangle"
                    size_hint_y: None
                    height: dp(72)

                MDTextField:
                    id: effective_date_input
                    text: root.effective_date_text
                    hint_text: "Effective date"
                    helper_text: "YYYY-MM-DD; existing profile dates cannot be reused"
                    helper_text_mode: "persistent"
                    mode: "rectangle"
                    size_hint_y: None
                    height: dp(72)

                OutlinedCard:
                    orientation: "vertical"
                    size_hint_y: None
                    height: self.minimum_height
                    padding: dp(12)
                    spacing: dp(6)
                    md_bg_color: get_color_from_hex(Colors.SURFACE_MUTED)

                    MDLabel:
                        text: "Day count"
                        size_hint_y: None
                        height: dp(20)
                        font_size: "12sp"
                        theme_text_color: "Custom"
                        text_color: get_color_from_hex(Colors.TEXT_SECONDARY)

                    MDLabel:
                        text: root.day_count_text + " (fixed for v1.4.0)"
                        size_hint_y: None
                        height: dp(24)
                        bold: True
                        theme_text_color: "Custom"
                        text_color: get_color_from_hex(Colors.TEXT_PRIMARY)

                GridLayout:
                    cols: 2
                    size_hint_y: None
                    height: dp(72)
                    spacing: dp(8)

                    OutlinedCard:
                        orientation: "vertical"
                        padding: dp(10)
                        spacing: dp(2)
                        md_bg_color: get_color_from_hex(Colors.SURFACE)

                        MDLabel:
                            text: "TODAY'S ESTIMATE"
                            font_size: "11sp"
                            theme_text_color: "Custom"
                            text_color: get_color_from_hex(Colors.TEXT_SECONDARY)

                        MDLabel:
                            text: root.today_estimate_text
                            bold: True
                            theme_text_color: "Custom"
                            text_color: get_color_from_hex(Colors.BRAND_PRIMARY)

                    OutlinedCard:
                        orientation: "vertical"
                        padding: dp(10)
                        spacing: dp(2)
                        md_bg_color: get_color_from_hex(Colors.SURFACE)

                        MDLabel:
                            text: "UNPOSTED ACCRUED"
                            font_size: "11sp"
                            theme_text_color: "Custom"
                            text_color: get_color_from_hex(Colors.TEXT_SECONDARY)

                        MDLabel:
                            text: root.accumulated_estimate_text
                            bold: True
                            theme_text_color: "Custom"
                            text_color: get_color_from_hex(Colors.BRAND_PRIMARY)

                Widget:
                    size_hint_y: None
                    height: dp(4)

        BoxLayout:
            size_hint_y: None
            height: dp(48)
            spacing: dp(8)

            EnkryonSecondaryButton:
                text: "CANCEL"
                size_hint_x: 1
                on_release: root.dismiss()

            EnkryonSecondaryButton:
                text: "DISABLE"
                size_hint_x: 1
                disabled: not root.is_enabled
                opacity: 1 if root.is_enabled else 0
                on_release: root.disable()

            EnkryonPrimaryButton:
                text: "SAVE"
                size_hint_x: 1
                on_release: root.save()
