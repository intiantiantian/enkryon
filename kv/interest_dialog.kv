#:import Window kivy.core.window.Window
#:import dp kivy.metrics.dp
#:import get_color_from_hex kivy.utils.get_color_from_hex
#:import Colors theme.tokens.Colors

<InterestSettingsDialog>:
    height: root.calculate_height(Window.height)

    EnkryonOverlayCard:
        size_hint: 1, 1
        orientation: "vertical"
        padding: dp(20)
        spacing: dp(12)

        BoxLayout:
            size_hint_y: None
            height: dp(48)

            MDLabel:
                text: "Daily Bank Interest"
                font_size: "20sp"
                bold: True
                theme_text_color: "Custom"
                text_color: get_color_from_hex(Colors.TEXT_PRIMARY)
                shorten: True
                shorten_from: "right"
                max_lines: 1

            MDIconButton:
                icon: "close"
                theme_icon_color: "Custom"
                icon_color: get_color_from_hex(Colors.BRAND_PRIMARY)
                on_release: root.dismiss()

        MDLabel:
            text: root.account_name
            size_hint_y: None
            height: dp(28)
            bold: True
            font_size: "14sp"
            theme_text_color: "Custom"
            text_color: get_color_from_hex(Colors.BRAND_PRIMARY)
            shorten: True
            shorten_from: "right"
            max_lines: 1

        ScrollView:
            id: interest_scroll
            do_scroll_x: False
            scroll_y: 1
            bar_width: dp(4)
            bar_margin: dp(2)

            MDBoxLayout:
                orientation: "vertical"
                adaptive_height: True
                padding: [dp(6), dp(4), dp(8), dp(24)]
                spacing: dp(10)

                OutlinedCard:
                    orientation: "vertical"
                    size_hint_y: None
                    height: self.minimum_height
                    padding: dp(12)
                    spacing: dp(4)
                    md_bg_color: get_color_from_hex(Colors.SURFACE_MUTED)

                    MDLabel:
                        text: "ESTIMATE ONLY · NON-POSTING"
                        size_hint_y: None
                        height: dp(18)
                        font_size: "10sp"
                        bold: True
                        theme_text_color: "Custom"
                        text_color: get_color_from_hex(Colors.WARNING)

                    MDLabel:
                        text: "How estimates work"
                        size_hint_y: None
                        height: dp(20)
                        font_size: "12sp"
                        bold: True
                        theme_text_color: "Custom"
                        text_color: get_color_from_hex(Colors.TEXT_PRIMARY)

                    MDLabel:
                        text: "Enkryon estimates daily interest from the prior end-of-day posted balance. Estimates do not change account balances or Income until you explicitly reconcile a bank credit."
                        size_hint_y: None
                        height: self.texture_size[1]
                        text_size: self.width, None
                        font_size: "12sp"
                        theme_text_color: "Custom"
                        text_color: get_color_from_hex(Colors.TEXT_SECONDARY)

                BoxLayout:
                    orientation: "vertical"
                    size_hint_y: None
                    height: dp(76)
                    spacing: dp(2)

                    MDTextField:
                        id: apr_input
                        text: root.apr_text
                        hint_text: "APR (%)"
                        mode: "rectangle"
                        size_hint_y: None
                        height: dp(56)

                    MDLabel:
                        text: "Nominal APR · up to 6 decimal places"
                        size_hint_y: None
                        height: dp(20)
                        font_size: "10sp"
                        theme_text_color: "Custom"
                        text_color: get_color_from_hex(Colors.TEXT_SECONDARY)

                BoxLayout:
                    orientation: "vertical"
                    size_hint_y: None
                    height: dp(76)
                    spacing: dp(2)

                    MDTextField:
                        id: effective_date_input
                        text: root.effective_date_text
                        hint_text: "Effective date"
                        mode: "rectangle"
                        size_hint_y: None
                        height: dp(56)

                    MDLabel:
                        text: "YYYY-MM-DD · profile dates cannot be reused"
                        size_hint_y: None
                        height: dp(20)
                        font_size: "10sp"
                        theme_text_color: "Custom"
                        text_color: get_color_from_hex(Colors.TEXT_SECONDARY)

                OutlinedCard:
                    orientation: "vertical"
                    size_hint_y: None
                    height: dp(56)
                    padding: dp(8)
                    spacing: dp(2)
                    md_bg_color: get_color_from_hex(Colors.SURFACE_MUTED)

                    MDLabel:
                        text: "DAY-COUNT BASIS"
                        size_hint_y: None
                        height: dp(18)
                        font_size: "10sp"
                        theme_text_color: "Custom"
                        text_color: get_color_from_hex(Colors.TEXT_SECONDARY)

                    MDLabel:
                        text: root.day_count_text + " · fixed for v1.4.0"
                        size_hint_y: None
                        height: dp(24)
                        bold: True
                        font_size: "13sp"
                        theme_text_color: "Custom"
                        text_color: get_color_from_hex(Colors.TEXT_PRIMARY)

                GridLayout:
                    cols: 2
                    size_hint_y: None
                    height: dp(72)
                    spacing: dp(8)

                    OutlinedCard:
                        orientation: "vertical"
                        padding: dp(10)
                        spacing: dp(2)
                        md_bg_color: get_color_from_hex(Colors.SURFACE)

                        MDLabel:
                            text: "TODAY'S ESTIMATE"
                            size_hint_y: None
                            height: dp(20)
                            font_size: "10sp"
                            theme_text_color: "Custom"
                            text_color: get_color_from_hex(Colors.TEXT_SECONDARY)

                        MDLabel:
                            text: root.today_estimate_text
                            size_hint_y: None
                            height: dp(30)
                            font_size: "16sp"
                            bold: True
                            theme_text_color: "Custom"
                            text_color: get_color_from_hex(Colors.BRAND_PRIMARY)

                    OutlinedCard:
                        orientation: "vertical"
                        padding: dp(10)
                        spacing: dp(2)
                        md_bg_color: get_color_from_hex(Colors.SURFACE)

                        MDLabel:
                            text: "UNPOSTED ACCRUED"
                            size_hint_y: None
                            height: dp(20)
                            font_size: "10sp"
                            theme_text_color: "Custom"
                            text_color: get_color_from_hex(Colors.TEXT_SECONDARY)

                        MDLabel:
                            text: root.accumulated_estimate_text
                            size_hint_y: None
                            height: dp(30)
                            font_size: "16sp"
                            bold: True
                            theme_text_color: "Custom"
                            text_color: get_color_from_hex(Colors.BRAND_PRIMARY)

        BoxLayout:
            size_hint_y: None
            height: dp(48)
            spacing: dp(8)

            MDRectangleFlatButton:
                text: "CANCEL"
                size_hint_x: 1
                size_hint_y: None
                height: dp(48)
                radius: [dp(14), dp(14), dp(14), dp(14)]
                line_width: 1.2
                line_color: get_color_from_hex(Colors.BRAND_PRIMARY)
                md_bg_color: get_color_from_hex(Colors.SURFACE)
                text_color: get_color_from_hex(Colors.BRAND_PRIMARY)
                on_release: root.dismiss()

            MDRectangleFlatButton:
                text: "DISABLE"
                size_hint_x: 1 if root.is_enabled else None
                size_hint_y: None
                height: dp(48)
                width: dp(0) if not root.is_enabled else dp(112)
                radius: [dp(14), dp(14), dp(14), dp(14)]
                line_width: 1.2
                line_color: get_color_from_hex(Colors.ERROR)
                md_bg_color: get_color_from_hex(Colors.SURFACE)
                text_color: get_color_from_hex(Colors.ERROR)
                disabled: not root.is_enabled
                opacity: 1 if root.is_enabled else 0
                on_release: root.disable()

            EnkryonPrimaryButton:
                text: "SAVE"
                size_hint_x: 1
                on_release: root.save()
