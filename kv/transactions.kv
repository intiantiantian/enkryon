#:import Window kivy.core.window.Window
#:import Metrics kivy.metrics.Metrics
#:import should_stack_controls utils.responsive_layout.should_stack_controls


<TransactionsScreen>
    BoxLayout:
        orientation: 'vertical'
        canvas.before:
            Color:
                rgba: get_color_from_hex(Colors.BACKGROUND)

            Rectangle:
                pos: self.pos
                size: self.size

        BoxLayout:
            orientation: 'horizontal'
            size_hint_y: None
            height: '64dp'
            padding: '16dp', 0
            spacing: '8dp'
            canvas.before:
                Color:
                    rgba: get_color_from_hex(Colors.BRAND_PRIMARY)

                Rectangle:
                    pos: self.pos
                    size: self.size
                    
            MDIconButton:
                icon: 'arrow-left'
                on_release: root.go_to_dashboard()
                theme_icon_color: 'Custom'
                icon_color: get_color_from_hex(Colors.TEXT_ON_PRIMARY)
                pos_hint: {'center_y': .5}

            MDLabel:
                text: 'Activity History'
                font_size: '26sp'
                size_hint_x: 1
                theme_text_color: 'Custom'
                text_color: get_color_from_hex(Colors.TEXT_ON_PRIMARY)

        Widget:
            size_hint_y: None
            height: "1dp"

            canvas.before:
                Color:
                    rgba: get_color_from_hex(Colors.BORDER)

                Rectangle:
                    pos: self.pos
                    size: self.size        

        BoxLayout:
            id: search_controls
            size_hint_y: None
            height: '72dp'
            padding: '10dp', '4dp'
            spacing: '8dp'

            MDTextField:
                id: transaction_search
                hint_text: 'Search activity'
                helper_text: 'Notes, accounts, categories, counterparties'
                helper_text_mode: 'on_focus'
                icon_left: 'magnify'
                mode: 'rectangle'
                size_hint_x: 1
                pos_hint: {'center_y': .5}
                on_text:
                    root.set_search_text(self.text)

            EnkryonPrimaryButton:
                text: 'CLEAR'
                size_hint: None, None
                width: '88dp'
                height: '48dp'
                pos_hint: {'center_y': .5 - dp(4) / (search_controls.height - search_controls.padding[1] - search_controls.padding[3])}
                disabled: not transaction_search.text
                opacity: 1 if transaction_search.text else .38
                on_release:
                    root.clear_search()

        GridLayout:
            id: primary_activity_filters
            cols: 1 if should_stack_controls(Window.width / dp(1), Metrics.fontscale) else 4
            size_hint_y: None
            height: self.minimum_height
            padding: '10dp'
            spacing: '10dp'
            row_default_height: '44dp'
            row_force_default: True

            EnkryonFilterButton:
                id: all_filter
                text: 'All'
                size_hint_x: 1
                selected: True
                on_release:
                    root.set_transaction_filter(None)

            EnkryonFilterButton:
                id: income_filter
                text: 'INCOME'
                size_hint_x: 1
                on_release:
                    root.set_transaction_filter('income')

            EnkryonFilterButton:
                id: expense_filter
                text: 'EXPENSE'
                size_hint_x: 1
                on_release:
                    root.set_transaction_filter('expense')

            EnkryonFilterButton:
                id: transfer_filter
                text: 'TRANSFER'
                size_hint_x: 1
                on_release:
                    root.set_transaction_filter('transfer')

        OutlinedCard:
            id: advanced_filters_section
            orientation: 'vertical'
            size_hint_x: None
            width: self.parent.width - dp(20)
            pos_hint: {'center_x': .5}
            size_hint_y: None
            height: self.minimum_height
            padding: '16dp'
            spacing:
                dp(8) if root.advanced_filters_expanded else 0
            radius: [12]
            elevation: 1

            EnkryonSecondaryButton:
                id: advanced_filters_toggle
                text: 'HIDE ADVANCED FILTERS' if root.advanced_filters_expanded else 'SHOW ADVANCED FILTERS'
                size_hint: 1, None
                height: '48dp'
                elevation: 0
                on_release:
                    root.toggle_advanced_filters()

            GridLayout:
                id: secondary_activity_filters
                cols: 1 if should_stack_controls(Window.width / dp(1), Metrics.fontscale) else 3
                size_hint_y: None
                height:
                    self.minimum_height if root.advanced_filters_expanded else 0
                opacity: 1 if root.advanced_filters_expanded else 0
                disabled: not root.advanced_filters_expanded
                padding: '10dp', '0dp'
                spacing: '10dp'
                row_default_height: '44dp'
                row_force_default: True

                EnkryonFilterButton:
                    id: internal_transfer_filter
                    text: 'INTERNAL'
                    size_hint_x: 1
                    on_release:
                        root.set_transfer_kind_filter('internal')

                EnkryonFilterButton:
                    id: pass_through_filter
                    text: 'PASS-THROUGH'
                    size_hint_x: 1
                    on_release:
                        root.set_transfer_kind_filter('pass_through')

                EnkryonFilterButton:
                    id: pending_filter
                    text: 'PENDING'
                    size_hint_x: 1
                    on_release:
                        root.set_transaction_filter('pending')

            ScrollView:
                id: advanced_filter_scroll
                size_hint_y: None
                height:
                    dp(64) if root.advanced_filters_expanded else 0
                opacity: 1 if root.advanced_filters_expanded else 0
                disabled: not root.advanced_filters_expanded
                do_scroll_x: True
                do_scroll_y: False
                bar_width: '4dp'

                BoxLayout:
                    size_hint_x: None
                    width: self.minimum_width
                    padding: '10dp', '4dp'
                    spacing: '8dp'

                    OutlinedCard:
                        id: account_filter
                        size_hint: None, None
                        width: '160dp'
                        height: root.ids.all_filter.height
                        pos_hint: {'center_y': .5}
                        ripple_behavior: True
                        on_release:
                            root.open_account_filter_menu()

                        MDLabel:
                            id: account_filter_label
                            text: 'All Accounts'
                            font_size: root.ids.all_filter.font_size
                            halign: 'center'
                            valign: 'middle'
                            text_size: self.width - dp(16), self.height
                            max_lines: 1
                            shorten: True
                            shorten_from: 'right'
                            theme_text_color: 'Custom'
                            text_color:
                                get_color_from_hex(Colors.BRAND_PRIMARY)

                    OutlinedCard:
                        id: group_filter
                        size_hint: None, None
                        width: '176dp'
                        height: root.ids.all_filter.height
                        pos_hint: {'center_y': .5}
                        ripple_behavior: True
                        on_release:
                            root.open_group_filter_menu()

                        MDLabel:
                            id: group_filter_label
                            text: 'All Category Groups'
                            font_size: root.ids.all_filter.font_size
                            halign: 'center'
                            valign: 'middle'
                            text_size: self.width - dp(16), self.height
                            max_lines: 1
                            shorten: True
                            shorten_from: 'right'
                            theme_text_color: 'Custom'
                            text_color:
                                get_color_from_hex(Colors.BRAND_PRIMARY)

                    OutlinedCard:
                        id: category_filter
                        size_hint: None, None
                        width: '160dp'
                        height: root.ids.all_filter.height
                        pos_hint: {'center_y': .5}
                        ripple_behavior: True
                        disabled: True
                        opacity: .38
                        on_release:
                            root.open_category_filter_menu()

                        MDLabel:
                            id: category_filter_label
                            text: 'All Categories'
                            font_size: root.ids.all_filter.font_size
                            halign: 'center'
                            valign: 'middle'
                            text_size: self.width - dp(16), self.height
                            max_lines: 1
                            shorten: True
                            shorten_from: 'right'
                            theme_text_color: 'Custom'
                            text_color:
                                get_color_from_hex(Colors.BRAND_PRIMARY)

                    OutlinedCard:
                        id: start_date_filter
                        size_hint: None, None
                        width: '152dp'
                        height: root.ids.all_filter.height
                        pos_hint: {'center_y': .5}
                        ripple_behavior: True
                        on_release:
                            root.open_start_date_filter()

                        MDLabel:
                            id: start_date_filter_label
                            text: 'From Date'
                            font_size: root.ids.all_filter.font_size
                            halign: 'center'
                            valign: 'middle'
                            text_size: self.width - dp(16), self.height
                            max_lines: 1
                            shorten: True
                            shorten_from: 'right'
                            theme_text_color: 'Custom'
                            text_color:
                                get_color_from_hex(Colors.BRAND_PRIMARY)

                    OutlinedCard:
                        id: end_date_filter
                        size_hint: None, None
                        width: '152dp'
                        height: root.ids.all_filter.height
                        pos_hint: {'center_y': .5}
                        ripple_behavior: True
                        on_release:
                            root.open_end_date_filter()

                        MDLabel:
                            id: end_date_filter_label
                            text: 'Through Date'
                            font_size: root.ids.all_filter.font_size
                            halign: 'center'
                            valign: 'middle'
                            text_size: self.width - dp(16), self.height
                            max_lines: 1
                            shorten: True
                            shorten_from: 'right'
                            theme_text_color: 'Custom'
                            text_color:
                                get_color_from_hex(Colors.BRAND_PRIMARY)

        BoxLayout:
            id: active_filter_summary
            size_hint_y: None
            height: '56dp'
            padding: '10dp', '4dp'
            spacing: '8dp'

            MDLabel:
                id: active_filters_label
                text: 'No active filters'
                halign: 'left'
                valign: 'middle'
                text_size: self.width, self.height
                max_lines: 2
                font_size: '12sp'
                theme_text_color: 'Custom'
                text_color: get_color_from_hex(Colors.TEXT_SECONDARY)

            EnkryonSecondaryButton:
                id: reset_all_filters
                text: 'RESET ALL'
                size_hint: None, None
                width: '104dp'
                height: '48dp'
                pos_hint: {'center_y': .5}
                disabled: True
                opacity: .38
                on_release:
                    root.show_all_transactions()

        FloatLayout:
            canvas.before:
                Color:
                    rgba: get_color_from_hex(Colors.BACKGROUND)

                Rectangle:
                    pos: self.pos
                    size: self.size

            RecycleView:
                id: transactions_recycle_view
                viewclass: 'TransactionHistoryCard'
                bar_width: '4dp'

                RecycleBoxLayout:
                    default_size:
                        None, dp(88) * max(1, Metrics.fontscale)
                    default_size_hint: 1, None
                    size_hint_y: None
                    height: self.minimum_height
                    orientation: 'vertical'
                    spacing: '5dp'
                    padding: '5dp'

            AnchorLayout:
                id: transaction_empty_state_container
                anchor_x: 'center'
                anchor_y: 'center'
                padding: '5dp'
