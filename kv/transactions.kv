<TransactionsScreen>
    BoxLayout:
        orientation: 'vertical'
        canvas.before:
            Color:
                rgba: get_color_from_hex(Colors.BACKGROUND)

            Rectangle:
                pos: self.pos
                size: self.size

        BoxLayout:
            orientation: 'horizontal'
            size_hint_y: None
            height: '64dp'
            padding: '16dp', 0
            spacing: '8dp'
            canvas.before:
                Color:
                    rgba: get_color_from_hex(Colors.SURFACE_MUTED)

                Rectangle:
                    pos: self.pos
                    size: self.size
                    
            MDIconButton:
                icon: 'arrow-left'
                on_release: root.go_to_dashboard()
                theme_icon_color: 'Custom'
                icon_color: get_color_from_hex(Colors.BRAND_PRIMARY)
                pos_hint: {'center_y': .5}

            MDLabel:
                text: 'Transactions'
                font_size: '26sp'
                size_hint_x: 1
                theme_text_color: 'Custom'
                text_color: get_color_from_hex(Colors.BRAND_PRIMARY)

        Widget:
            size_hint_y: None
            height: "1dp"

            canvas.before:
                Color:
                    rgba: get_color_from_hex(Colors.BORDER)

                Rectangle:
                    pos: self.pos
                    size: self.size        

        BoxLayout:
            size_hint_y: None
            height: '56dp'
            padding: '10dp'

            orientation: 'horizontal'
            spacing: '10dp'

            OutlinedCard:
                id: all_filter
                on_release:
                    root.set_transaction_filter(None)
                md_bg_color: get_color_from_hex(Colors.BRAND_ACCENT_SOFT)
                radius: [10]

                MDLabel:
                    halign: 'center'
                    text: 'All'
                    theme_text_color: 'Custom'
                    text_color: get_color_from_hex(Colors.BRAND_PRIMARY)

            OutlinedCard:
                id: income_filter
                on_release:
                    root.set_transaction_filter('income')
                md_bg_color: get_color_from_hex(Colors.BRAND_ACCENT_SOFT)
                radius: [10]

                MDLabel:
                    halign: 'center'
                    text: 'INCOME'
                    theme_text_color: 'Custom'
                    text_color: get_color_from_hex(Colors.BRAND_PRIMARY)

            OutlinedCard:
                id: expense_filter
                on_release:
                    root.set_transaction_filter('expense')
                md_bg_color: get_color_from_hex(Colors.BRAND_ACCENT_SOFT)
                radius: [10]

                MDLabel:
                    halign: 'center'
                    text: 'EXPENSE'
                    theme_text_color: 'Custom'
                    text_color: get_color_from_hex(Colors.BRAND_PRIMARY)

        ScrollView:
            BoxLayout:
                id: transactions_container
                orientation: 'vertical'
                size_hint_y: None
                height: self.minimum_height
                spacing: '5dp'
                padding: '5dp'
                canvas.before:
                    Color:
                        rgba: get_color_from_hex(Colors.BACKGROUND)

                    Rectangle:
                        pos: self.pos
                        size: self.size