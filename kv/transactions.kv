#:import Window kivy.core.window.Window
#:import Metrics kivy.metrics.Metrics
#:import should_stack_controls utils.responsive_layout.should_stack_controls


<TransactionsScreen>
    BoxLayout:
        orientation: 'vertical'
        canvas.before:
            Color:
                rgba: get_color_from_hex(Colors.BACKGROUND)

            Rectangle:
                pos: self.pos
                size: self.size

        BoxLayout:
            orientation: 'horizontal'
            size_hint_y: None
            height: '64dp'
            padding: '16dp', 0
            spacing: '8dp'
            canvas.before:
                Color:
                    rgba: get_color_from_hex(Colors.BRAND_PRIMARY)

                Rectangle:
                    pos: self.pos
                    size: self.size
                    
            MDIconButton:
                icon: 'arrow-left'
                on_release: root.go_to_dashboard()
                theme_icon_color: 'Custom'
                icon_color: get_color_from_hex(Colors.TEXT_ON_PRIMARY)
                pos_hint: {'center_y': .5}

            MDLabel:
                text: 'Transactions'
                font_size: '26sp'
                size_hint_x: 1
                theme_text_color: 'Custom'
                text_color: get_color_from_hex(Colors.TEXT_ON_PRIMARY)

        Widget:
            size_hint_y: None
            height: "1dp"

            canvas.before:
                Color:
                    rgba: get_color_from_hex(Colors.BORDER)

                Rectangle:
                    pos: self.pos
                    size: self.size        

        BoxLayout:
            id: search_controls
            size_hint_y: None
            height: '72dp'
            padding: '10dp', '4dp'
            spacing: '8dp'

            MDTextField:
                id: transaction_search
                hint_text: 'Search transactions'
                helper_text: 'Notes, account, group, or category'
                helper_text_mode: 'on_focus'
                icon_left: 'magnify'
                mode: 'rectangle'
                size_hint_x: 1
                pos_hint: {'center_y': .5}
                on_text:
                    root.set_search_text(self.text)

            EnkryonPrimaryButton:
                text: 'CLEAR'
                size_hint: None, None
                width: '88dp'
                height: '48dp'
                pos_hint: {'center_y': .5 - dp(4) / (search_controls.height - search_controls.padding[1] - search_controls.padding[3])}
                disabled: not transaction_search.text
                opacity: 1 if transaction_search.text else .38
                on_release:
                    root.clear_search()

        GridLayout:
            cols: 1 if should_stack_controls(Window.width / dp(1), Metrics.fontscale) else 3
            size_hint_y: None
            height: self.minimum_height
            padding: '10dp'
            spacing: '10dp'
            row_default_height: '44dp'
            row_force_default: True

            EnkryonFilterButton:
                id: all_filter
                text: 'All'
                size_hint_x: 1
                selected: True
                on_release:
                    root.set_transaction_filter(None)

            EnkryonFilterButton:
                id: income_filter
                text: 'INCOME'
                size_hint_x: 1
                on_release:
                    root.set_transaction_filter('income')

            EnkryonFilterButton:
                id: expense_filter
                text: 'EXPENSE'
                size_hint_x: 1
                on_release:
                    root.set_transaction_filter('expense')

        ScrollView:
            BoxLayout:
                id: transactions_container
                orientation: 'vertical'
                size_hint_y: None
                height: self.minimum_height
                spacing: '5dp'
                padding: '5dp'
                canvas.before:
                    Color:
                        rgba: get_color_from_hex(Colors.BACKGROUND)

                    Rectangle:
                        pos: self.pos
                        size: self.size
