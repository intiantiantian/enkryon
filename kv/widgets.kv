#:import get_color_from_hex kivy.utils.get_color_from_hex
#:import Colors theme.tokens.Colors
#:import Window kivy.core.window.Window

<OutlinedCard@MDCard>:
    radius: [10]
    elevation: 1

    canvas.after:
        Color:
            rgba: get_color_from_hex(Colors.BRAND_PRIMARY)

        Line:
            rounded_rectangle:
                (self.x, self.y,
                self.width, self.height,
                self.radius[0])
            width: 1.2

<KeypadButton@OutlinedCard>
    ripple_behavior: True
    md_bg_color: get_color_from_hex(Colors.SURFACE)
    size_hint_y: None
    height: '48dp'

    AnchorLayout:
        anchor_x: "center"
        anchor_y: "center"

        MDLabel:
            id: label
            text: ""
            halign: "center"
            theme_text_color: "Custom"
            text_color: get_color_from_hex(Colors.BRAND_PRIMARY)
            opacity: 1

        MDIcon:
            id: icon
            icon: ""
            theme_text_color: "Custom"
            text_color: get_color_from_hex(Colors.BRAND_PRIMARY)
            opacity: 0

<AppSnackbar>:
    size_hint: None, None
    width: Window.width * 0.8
    height: "52dp"
    radius: [12]

    md_bg_color: get_color_from_hex(Colors.BRAND_PRIMARY)

    elevation: 2

    opacity: 0

    MDLabel:
        id: text_label
        halign: "center"
        theme_text_color: "Custom"
        text_color: 1,1,1,1

<TransactionCard>
    size_hint_y: None
    height: self.minimum_height

    canvas.after:
        Color:
            rgba: get_color_from_hex(Colors.BRAND_PRIMARY)

        Line:
            rounded_rectangle:
                (self.x, self.y,
                self.width, self.height,
                self.radius[0])
            width: 1.2

    BoxLayout:
        orientation: 'horizontal'
        padding: '10dp'
        size_hint: 1, None
        height: self.minimum_height

        BoxLayout:
            size_hint_y: None
            height: self.minimum_height

            BoxLayout:
                orientation: 'vertical'
                size_hint: 1, None
                adaptive_height: True

                MDLabel:
                    id: account_name
                    text_size: self.size
                    max_lines: 1
                    shorten: True
                    shorten_from: 'right'

                MDLabel:
                    id: date_time
                    font_size: '8sp'
                    text_size: self.size
                    max_lines: 1
                    shorten: True
                    shorten_from: 'right'

            BoxLayout:
                orientation: 'vertical'
                size_hint: 1, None
                adaptive_height: True

                MDLabel:
                    id: group_name
                    font_size: '12sp'
                    text_size: self.size
                    max_lines: 1
                    shorten: True
                    shorten_from: 'right'

                MDLabel:
                    id: category_name
                    font_size: '12sp'
                    text_size: self.size
                    max_lines: 1
                    shorten: True
                    shorten_from: 'right'

            BoxLayout:
                orientation: 'vertical'
                size_hint: 1, None
                adaptive_height: True

                BoxLayout:
                    size_hint_y: None
                    height: '24dp'
                    spacing: '4dp'

                    MDIcon:
                        id: transaction_type_icon
                        size_hint_x: None
                        width: '18dp'
                        font_size: '14sp'
                        halign: 'center'
                        valign: 'middle'
                        text_size: self.size
                        theme_text_color: 'Custom'

                    MDLabel:
                        id: transaction_type
                        font_size: '12sp'
                        theme_text_color: 'Custom'

                MDLabel:
                    id: amount
                    halign: 'right'
                    valign: 'middle'
                    text_size: self.size
                    max_lines: 1
                    shorten: True
                    shorten_from: 'left'
                    theme_text_color: 'Custom'

        BoxLayout:
            size_hint_x: None
            width: self.minimum_width

            MDIconButton:
                icon: 'pencil'
                icon_size: '18sp'
                on_release:
                    root.edit_transaction()

            MDIconButton:
                icon: 'delete'
                icon_size: '18sp'
                on_release:
                    root.delete_transaction()

<EmptyState>:
    orientation: "vertical"
    size_hint_y: None
    height: "140dp"
    padding: "16dp"
    spacing: "8dp"

    MDLabel:
        text: root.title
        halign: "center"
        font_size: "16sp"
        bold: True
        theme_text_color: "Custom"
        text_color: get_color_from_hex(Colors.BRAND_PRIMARY)

    MDLabel:
        text: root.message
        halign: "center"
        font_size: "13sp"
        theme_text_color: "Custom"
        text_color: get_color_from_hex(Colors.TEXT_SECONDARY)
