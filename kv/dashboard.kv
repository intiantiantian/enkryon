#:import Window kivy.core.window.Window
#:import Metrics kivy.metrics.Metrics
#:import should_stack_controls utils.responsive_layout.should_stack_controls


<DashboardScreen>:
    BoxLayout:
        orientation: 'vertical'
        canvas.before:
            Color:
                rgba: get_color_from_hex(Colors.BACKGROUND)

            Rectangle:
                pos: self.pos
                size: self.size

        BoxLayout:
            orientation: 'horizontal'
            size_hint_y: None
            height: '64dp'
            padding: '16dp', 0
            spacing: '8dp'
            canvas.before:
                Color:
                    rgba: get_color_from_hex(Colors.BRAND_PRIMARY)

                Rectangle:
                    pos: self.pos
                    size: self.size
                    
            MDLabel:
                text: 'Dashboard'
                font_size: '26sp'
                size_hint_x: 1
                theme_text_color: 'Custom'
                text_color: get_color_from_hex(Colors.TEXT_ON_PRIMARY)

            MDIconButton:
                icon: 'cog'
                on_release: root.go_to_settings()
                theme_icon_color: 'Custom'
                icon_color: get_color_from_hex(Colors.TEXT_ON_PRIMARY)
                pos_hint: {'center_y': .5}

        Widget:
            size_hint_y: None
            height: "1dp"

            canvas.before:
                Color:
                    rgba: get_color_from_hex(Colors.BORDER)

                Rectangle:
                    pos: self.pos
                    size: self.size    

        ScrollView:

            BoxLayout:
                orientation: 'vertical'
                size_hint_y: None
                height: self.minimum_height
                spacing: '10dp'
                padding: '10dp'

                GridLayout:
                    cols: 1 if should_stack_controls(Window.width / dp(1), Metrics.fontscale) else 2
                    size_hint_y: None
                    height: self.minimum_height
                    row_default_height: dp(200) * max(1, Metrics.fontscale)
                    row_force_default: True
                    spacing: '10dp'

                    OutlinedCard:
                        radius: [12]
                        elevation: 1
                        padding: '10dp'
                        size_hint_x: .35
                        MDLabel:
                            halign: 'center'
                            text: 'Welcome!'
                            font_size: '26sp'

                    OutlinedCard:
                        radius: [12]
                        elevation: 1
                        padding: '5dp'
                        spacing: '10dp'
                        size_hint_x: .65
                        orientation: 'vertical'
                        BoxLayout:
                            size_hint_y: None
                            height: '48dp'
                                
                            OutlinedCard:
                                id: account_selector
                                ripple_behavior: True
                                md_bg_color: get_color_from_hex(Colors.BRAND_ACCENT_SOFT)
                                radius: [10]
                                size_hint_x: 1
                                on_release:
                                    root.open_account_menu()

                                MDLabel:
                                    halign: 'center'
                                    id: account_label
                                    theme_text_color: 'Custom'
                                    text_color: get_color_from_hex(Colors.BRAND_PRIMARY)
                                    valign: 'middle'
                                    text_size: self.width - dp(16), self.height
                                    max_lines: 1
                                    shorten: True
                                    shorten_from: 'right'

                            MDIconButton:
                                id: eye_button
                                theme_icon_color: 'Custom'
                                icon_color: get_color_from_hex(Colors.BRAND_PRIMARY)
                                on_release:
                                    root.toggle_balance()

                        MDCard:
                            orientation: 'vertical'
                            padding: '16dp'
                            spacing: '4dp'

                            MDLabel:
                                text: 'Current Balance'
                                font_size: '20sp'
                                halign: 'right'
                                theme_text_color: 'Custom'
                                text_color: get_color_from_hex(Colors.TEXT_MUTED)
                            
                            MDLabel:
                                id: balance_label
                                font_size: min(sp(42), self.width / max(len(self.text) * .58, 1))
                                halign: 'right'
                                valign: 'middle'
                                text_size: self.size
                                max_lines: 1
                                shorten: True
                                shorten_from: 'left'

                GridLayout:
                    id: dashboard_actions
                    cols: 1 if should_stack_controls(Window.width / dp(1), Metrics.fontscale) else 2
                    size_hint_y: None
                    height: self.minimum_height
                    row_default_height: '48dp'
                    row_force_default: True
                    spacing: '5dp'

                    EnkryonPrimaryButton:
                        size_hint: 1, None
                        on_release:
                            root.go_to_add_transaction()

                        text: '+ Add Transaction'
                        theme_text_color: 'Custom'
                        text_color: get_color_from_hex(Colors.TEXT_ON_PRIMARY)

                    EnkryonPrimaryButton:
                        size_hint: 1, None
                        on_release:
                            root.go_to_transfer()

                        text: 'Transfer Funds'
                        theme_text_color: 'Custom'
                        text_color: get_color_from_hex(Colors.TEXT_ON_PRIMARY)

                    EnkryonPrimaryButton:
                        size_hint: 1, None
                        on_release:
                            root.go_to_accounts()

                        text: 'Manage Accounts'
                        theme_text_color: 'Custom'
                        text_color: get_color_from_hex(Colors.TEXT_ON_PRIMARY)

                    EnkryonPrimaryButton:
                        size_hint: 1, None
                        on_release:
                            root.go_to_categories()

                        text: 'Manage Categories'
                        theme_text_color: 'Custom'
                        text_color: get_color_from_hex(Colors.TEXT_ON_PRIMARY)

                GridLayout:
                    cols: 1 if should_stack_controls(Window.width / dp(1), Metrics.fontscale) else 2
                    size_hint_y: None
                    height: self.minimum_height
                    row_default_height: '144dp'
                    row_force_default: True
                    spacing: '10dp'

                    OutlinedCard:
                        # go to income overview
                        on_release: 
                            root.go_to_transactions()
                        radius: [12]
                        elevation: 1
                        padding: '5dp'
                        spacing: '10dp'
                        ripple_behavior: True
                        orientation: 'vertical'
 
                        MDCard:
                            ripple_behavior: True
                            radius: [10]
                            size_hint_y: .35

                            OutlinedCard:
                                md_bg_color: get_color_from_hex(Colors.BRAND_ACCENT_SOFT)

                                MDLabel:
                                    halign: 'center'
                                    text: 'INCOME'
                                    theme_text_color: 'Custom'
                                    text_color: get_color_from_hex(Colors.BRAND_PRIMARY)

                        MDLabel:
                            id: income_label
                            theme_text_color: 'Custom'
                            text_color: get_color_from_hex(Colors.INCOME)
                            font_size: '32sp'
                            halign: 'center'
                            valign: 'middle'
                            text_size: self.size
                            max_lines: 1
                            shorten: True
                            shorten_from: 'left'
                            size_hint_y: .65

                    OutlinedCard:
                        # go to expense overview
                        on_release: 
                            root.go_to_transactions()
                        radius: [12]
                        elevation: 1
                        padding: '5dp'
                        spacing: '10dp'
                        ripple_behavior: True
                        orientation: 'vertical'

                        MDCard:
                            ripple_behavior: True
                            radius: [10]
                            size_hint_y: .35

                            OutlinedCard:
                                md_bg_color: get_color_from_hex(Colors.BRAND_ACCENT_SOFT)
                                MDLabel:
                                    halign: 'center'
                                    text: 'EXPENSE'
                                    theme_text_color: 'Custom'
                                    text_color: get_color_from_hex(Colors.BRAND_PRIMARY)

                        MDLabel:
                            id: expense_label
                            theme_text_color: 'Custom'
                            text_color: get_color_from_hex(Colors.EXPENSE)
                            font_size: '32sp'
                            halign: 'center'
                            valign: 'middle'
                            text_size: self.size
                            max_lines: 1
                            shorten: True
                            shorten_from: 'left'
                            size_hint_y: .65

                MDCard:
                    orientation: 'vertical'
                    spacing: '10dp'
                    padding: '10dp'
                    size_hint_y: None
                    height: self.minimum_height
                    elevation: 1

                    BoxLayout:
                        size_hint_y: None
                        height: '44dp'
                        orientation: 'horizontal'

                        MDLabel:
                            text: 'Recent Transactions'
                            size_hint_x: 1
                            font_size: '26sp'
                            theme_text_color: 'Custom'
                            text_color: get_color_from_hex(Colors.TEXT_MUTED)
                            valign: 'middle'
                            text_size: self.width, self.height
                            max_lines: 1
                            shorten: True
                            shorten_from: 'right'

                        MDIconButton:
                            icon: 'chevron-right'
                            pos_hint: {'center_y': .5}
                            theme_icon_color: 'Custom'
                            icon_color: get_color_from_hex(Colors.BRAND_PRIMARY)
                            on_release:
                                root.go_to_transactions()

                    GridLayout:
                        cols: 1 if should_stack_controls(Window.width / dp(1), Metrics.fontscale) else 3
                        size_hint_y: None
                        height: self.minimum_height
                        row_default_height: '48dp'
                        row_force_default: True
                        spacing: '10dp'

                        EnkryonFilterButton:
                            id: all_filter
                            text: 'All'
                            size_hint_x: 1
                            selected: True
                            on_release:
                                root.set_transaction_filter(None)

                        EnkryonFilterButton:
                            id: income_filter
                            text: 'INCOME'
                            size_hint_x: 1
                            on_release:
                                root.set_transaction_filter('income')

                        EnkryonFilterButton:
                            id: expense_filter
                            text: 'EXPENSE'
                            size_hint_x: 1
                            on_release:
                                root.set_transaction_filter('expense')

                    BoxLayout:
                        id: transactions_container
                        orientation: 'vertical'
                        padding: '10dp'
                        spacing: '5dp'
                        size_hint_y: None
                        height: self.minimum_height
