<DashboardScreen>:
    BoxLayout:
        orientation: 'vertical'
        canvas.before:
            Color:
                rgba: get_color_from_hex(Colors.BACKGROUND)

            Rectangle:
                pos: self.pos
                size: self.size

        BoxLayout:
            orientation: 'horizontal'
            size_hint_y: None
            height: '64dp'
            padding: '16dp', 0
            spacing: '8dp'
            canvas.before:
                Color:
                    rgba: get_color_from_hex(Colors.SURFACE_MUTED)

                Rectangle:
                    pos: self.pos
                    size: self.size
                    
            MDLabel:
                text: 'Dashboard'
                font_size: '26sp'
                size_hint_x: 1
                theme_text_color: 'Custom'
                text_color: get_color_from_hex(Colors.BRAND_PRIMARY)

            MDIconButton:
                icon: 'cog'
                on_release: root.go_to_settings()
                theme_icon_color: 'Custom'
                icon_color: get_color_from_hex(Colors.BRAND_PRIMARY)
                pos_hint: {'center_y': .5}

        Widget:
            size_hint_y: None
            height: "1dp"

            canvas.before:
                Color:
                    rgba: get_color_from_hex(Colors.BORDER)

                Rectangle:
                    pos: self.pos
                    size: self.size    

        ScrollView:

            BoxLayout:
                orientation: 'vertical'
                size_hint_y: None
                height: self.minimum_height
                spacing: '10dp'
                padding: '10dp'

                BoxLayout:
                    size_hint_y: None
                    spacing: '10dp'
                    height: '200dp'

                    OutlinedCard:
                        radius: [12]
                        elevation: 1
                        padding: '10dp'
                        size_hint_x: .35
                        MDLabel:
                            halign: 'center'
                            text: 'Welcome!'
                            font_size: '26sp'

                    OutlinedCard:
                        radius: [12]
                        elevation: 1
                        padding: '5dp'
                        spacing: '10dp'
                        size_hint_x: .65
                        orientation: 'vertical'
                        BoxLayout:
                            size_hint_y: None
                            height: '48dp'
                                
                            OutlinedCard:
                                id: account_selector
                                ripple_behavior: True
                                md_bg_color: get_color_from_hex(Colors.BRAND_ACCENT_SOFT)
                                radius: [10]
                                size_hint_x: 1
                                on_release:
                                    root.open_account_menu()

                                MDLabel:
                                    halign: 'center'
                                    id: account_label
                                    theme_text_color: 'Custom'
                                    text_color: get_color_from_hex(Colors.BRAND_PRIMARY)

                            MDIconButton:
                                id: eye_button
                                theme_icon_color: 'Custom'
                                icon_color: get_color_from_hex(Colors.BRAND_PRIMARY)
                                on_release:
                                    root.toggle_balance()

                        MDCard:
                            orientation: 'vertical'
                            padding: '24dp'
                            spacing: '4dp'

                            MDLabel:
                                text: 'Current Balance'
                                font_size: '20sp'
                                halign: 'right'
                                theme_text_color: 'Custom'
                                text_color: get_color_from_hex('#9E9E9E')
                            
                            MDLabel:
                                id: balance_label
                                font_size: '42sp'
                                halign: 'right'
                                valign: 'middle'
                                text_size: self.size
                                max_lines: 1
                                shorten: True
                                shorten_from: 'left'
                
                BoxLayout:
                    orientation: 'horizontal'
                    size_hint_y: None
                    height: '56dp'
                    spacing: '5dp'
                        
                    OutlinedCard:
                        ripple_behavior: True
                        md_bg_color: get_color_from_hex(Colors.BRAND_PRIMARY)
                        radius: [12]
                        size_hint_x: 1
                        on_release:
                            root.go_to_add_transaction()

                        MDLabel:
                            text: '+ Add Transaction'
                            halign: 'center'
                            theme_text_color: 'Custom'
                            text_color: get_color_from_hex(Colors.TEXT_ON_PRIMARY)

                    OutlinedCard:
                        ripple_behavior: True
                        md_bg_color: get_color_from_hex(Colors.BRAND_PRIMARY)
                        radius: [12]
                        size_hint_x: 1
                        on_release:
                            root.go_to_accounts()

                        MDLabel:
                            text: 'Manage Accounts'
                            halign: 'center'
                            theme_text_color: 'Custom'
                            text_color: get_color_from_hex(Colors.TEXT_ON_PRIMARY)

                    OutlinedCard:
                        ripple_behavior: True
                        md_bg_color: get_color_from_hex(Colors.BRAND_PRIMARY)
                        radius: [12]
                        size_hint_x: 1
                        on_release:
                            root.go_to_categories()

                        MDLabel:
                            text: 'Manage Categories'
                            halign: 'center'
                            theme_text_color: 'Custom'
                            text_color: get_color_from_hex(Colors.TEXT_ON_PRIMARY)

                BoxLayout:
                    orientation: 'horizontal'
                    size_hint_y: None
                    height: '144dp'
                    spacing: '10dp'

                    OutlinedCard:
                        # go to income overview
                        on_release: 
                            root.go_to_transactions()
                        radius: [12]
                        elevation: 1
                        padding: '5dp'
                        spacing: '10dp'
                        ripple_behavior: True
                        orientation: 'vertical'
 
                        MDCard:
                            ripple_behavior: True
                            radius: [10]
                            size_hint_y: .35

                            OutlinedCard:
                                md_bg_color: get_color_from_hex(Colors.BRAND_ACCENT_SOFT)

                                MDLabel:
                                    halign: 'center'
                                    text: 'INCOME'
                                    theme_text_color: 'Custom'
                                    text_color: get_color_from_hex(Colors.BRAND_PRIMARY)

                        MDLabel:
                            id: income_label
                            font_size: '32sp'
                            halign: 'center'
                            valign: 'middle'
                            text_size: self.size
                            max_lines: 1
                            shorten: True
                            shorten_from: 'left'
                            size_hint_y: .65

                    OutlinedCard:
                        # go to expense overview
                        on_release: 
                            root.go_to_transactions()
                        radius: [12]
                        elevation: 1
                        padding: '5dp'
                        spacing: '10dp'
                        ripple_behavior: True
                        orientation: 'vertical'

                        MDCard:
                            ripple_behavior: True
                            radius: [10]
                            size_hint_y: .35

                            OutlinedCard:
                                md_bg_color: get_color_from_hex(Colors.BRAND_ACCENT_SOFT)
                                MDLabel:
                                    halign: 'center'
                                    text: 'EXPENSE'
                                    theme_text_color: 'Custom'
                                    text_color: get_color_from_hex(Colors.BRAND_PRIMARY)

                        MDLabel:
                            id: expense_label
                            font_size: '32sp'
                            halign: 'center'
                            valign: 'middle'
                            text_size: self.size
                            max_lines: 1
                            shorten: True
                            shorten_from: 'left'
                            size_hint_y: .65

                MDCard:
                    orientation: 'vertical'
                    spacing: '10dp'
                    padding: '10dp'
                    size_hint_y: None
                    height: self.minimum_height
                    elevation: 1

                    BoxLayout:
                        size_hint_y: None
                        height: '44dp'
                        orientation: 'horizontal'

                        MDLabel:
                            text: 'Recent Transactions'
                            size_hint_x: 1
                            font_size: '26sp'
                            theme_text_color: 'Custom'
                            text_color: get_color_from_hex('#9E9E9E')

                        MDIconButton:
                            icon: 'chevron-right'
                            pos_hint: {'center_y': .5}
                            theme_icon_color: 'Custom'
                            icon_color: get_color_from_hex(Colors.BRAND_PRIMARY)
                            on_release:
                                root.go_to_transactions()

                    BoxLayout:
                        size_hint_y: None
                        height: '44dp'

                        orientation: 'horizontal'
                        spacing: '10dp'

                        OutlinedCard:
                            id: all_filter
                            on_release:
                                root.set_transaction_filter(None)
                            md_bg_color: get_color_from_hex(Colors.BRAND_ACCENT_SOFT)
                            radius: [10]

                            MDLabel:
                                halign: 'center'
                                text: 'All'
                                theme_text_color: 'Custom'
                                text_color: get_color_from_hex(Colors.BRAND_PRIMARY)

                        OutlinedCard:
                            id: income_filter
                            on_release:
                                root.set_transaction_filter('income')
                            md_bg_color: get_color_from_hex(Colors.BRAND_ACCENT_SOFT)
                            radius: [10]

                            MDLabel:
                                halign: 'center'
                                text: 'INCOME'
                                theme_text_color: 'Custom'
                                text_color: get_color_from_hex(Colors.BRAND_PRIMARY)

                        OutlinedCard:
                            id: expense_filter
                            on_release:
                                root.set_transaction_filter('expense')
                            md_bg_color: get_color_from_hex(Colors.BRAND_ACCENT_SOFT)
                            radius: [10]

                            MDLabel:
                                halign: 'center'
                                text: 'EXPENSE'
                                theme_text_color: 'Custom'
                                text_color: get_color_from_hex(Colors.BRAND_PRIMARY)

                    BoxLayout:
                        id: transactions_container
                        orientation: 'vertical'
                        padding: '10dp'
                        spacing: '5dp'
                        size_hint_y: None
                        height: self.minimum_height