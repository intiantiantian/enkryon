<CategoryCard>
    size_hint_y: None
    height: category_content.height

    BoxLayout:
        id: category_content
        orientation: 'vertical'
        size_hint_y: None
        height: self.minimum_height

        BoxLayout:
            size_hint_y: None
            height: self.minimum_height

            Widget:
                size_hint_x: None
                width: 20

            MDLabel:
                id: category_name

            MDIconButton:
                icon: 'pencil'
                on_release:
                    root.edit_category()

            MDIconButton:
                icon: 'delete'
                on_release:
                    root.delete_category()

<CategoryGroupCard>
    size_hint_y: None
    height: group_content.height

    BoxLayout:
        id: group_content
        orientation: 'vertical'
        size_hint_y: None
        height: self.minimum_height

        BoxLayout:
            size_hint_y: None
            height: self.minimum_height

            MDLabel:
                id: group_name

            MDIconButton:
                icon: "pencil"
                on_release:
                    root.edit_group()

            MDIconButton:
                icon: "delete"
                on_release:
                    root.delete_group()

            MDIconButton:
                id: toggle_button
                icon: "chevron-down"
                on_release:
                    root.toggle_group()

        BoxLayout:
            id: categories_container
            orientation: 'vertical'
            size_hint_y: None
            height: self.minimum_height
            
<CategoriesScreen>:
    BoxLayout:
        orientation: 'vertical'
        padding: 20
        spacing: 15

        MDCard:
            size_hint_y: None
            height: 50

            BoxLayout:
                orientation: 'horizontal'

                MDLabel:
                    text: 'Header'

                MDIconButton:
                    icon: 'close'
                    on_release:
                        root.go_to_dashboard()

        MDCard:
            size_hint_y: None
            height: 50

            ToggleButton:
                id: income_button
                text: 'INCOME'
                group: 'transaction_type'
                on_release:
                    root.set_transaction_type('income')

            ToggleButton:
                id: expense_button
                text: 'EXPENSE'
                group: 'transaction_type'
                on_release:
                    root.set_transaction_type('expense')
            
        ScrollView:
            size_hint_y: 1
            
            BoxLayout:
                id: groups_container
                size_hint_y: None
                height: self.minimum_height
                orientation: 'vertical'

        MDTextField:
            id: group_name_input
            hint_text: 'Group Name'

        MDFillRoundFlatButton:
            size_hint_y: None
            height: 60
            text: '+ Add New Group'
            on_release:
                root.add_group()